# Postgres da instância "roadmap" no Easypanel (copie a URL interna do serviço)
DATABASE_URL=postgres://usuario:senha@host:5432/roadmap

# Segredo do cookie de login: 32+ caracteres aleatórios (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Token da API /api/* (Authorization: Bearer ...), 32+ caracteres. Deixe vazio para desligar a API.
API_TOKEN=

# Primeiro usuário, criado só quando a tabela de usuários está vazia
ADMIN_EMAIL=
ADMIN_NAME=Rafael
ADMIN_PASSWORD=
